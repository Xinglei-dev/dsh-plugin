{
  "name": "dsh-memorix-tools",
  "version": "0.1.0",
  "description": "Registers Memorix's MCP tools over a stateless connection and routes every call by the calling session's working directory, so parallel sessions can work in different projects",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./tools": "./lib/tools.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/tools.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memorix",
    "mcp",
    "memory"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "scripts": {
    "test": "node --test"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}
